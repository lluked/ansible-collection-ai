name: n8n
services:
  n8n:
    image: {{ n8n_image }}
    container_name: n8n
    restart: unless-stopped
{% if n8n_external_access | bool %}
    ports:
      - "{{ n8n_bind_address }}:{{ n8n_port }}:5678"
{% endif %}
    volumes:
      - {{ n8n_data_dir }}:/home/node/.n8n
    environment:
      GENERIC_TIMEZONE: "{{ n8n_timezone }}"
      TZ: "{{ n8n_timezone }}"
      N8N_SECURE_COOKIE: "{{ n8n_secure_cookie | lower }}"
      N8N_RUNNERS_ENABLED: "true"
    networks:
      - ai

networks:
  ai:
    name: {{ n8n_network }}
    external: true
