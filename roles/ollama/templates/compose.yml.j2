name: ollama
services:
  ollama:
    image: {{ ollama_image }}
    container_name: ollama
    restart: unless-stopped
{% if ollama_external_access | bool %}
    ports:
      - "{{ ollama_bind_address }}:{{ ollama_port }}:11434"
{% endif %}
    volumes:
      - {{ ollama_data_dir }}:/root/.ollama
    environment:
      OLLAMA_CONTEXT_LENGTH: "{{ ollama_context_length }}"
      OLLAMA_KEEP_ALIVE: "{{ ollama_keep_alive }}"
      OLLAMA_FLASH_ATTENTION: "1"
      OLLAMA_KV_CACHE_TYPE: q8_0
    deploy:
      resources:
        reservations:
          devices:
            - driver: nvidia
              count: all
              capabilities: [gpu]
    networks:
      - ai

networks:
  ai:
    name: {{ ollama_network }}
    external: true
